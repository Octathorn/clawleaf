## App (SSR + client)
## WhatsApp float: digits only with country code (e.g. 923379611572). Falls back if unset.
# VITE_WHATSAPP_NUMBER=923379611572

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-04-14
VITE_SANITY_USE_CDN=true

## SSR server (optional; VITE_ vars also work)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-04-14
SANITY_USE_CDN=true

## Sanity Studio (inside ./sanity)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

## Voice AI demo (/voice-ai) — client-side (baked into the build)
## Public Dograh API origin exposed via the Cloudflare tunnel.
VITE_VOICE_API_URL=https://voice-api.ot-technologies.com
## Browser-tab embed tokens per use case — JSON { "<agentId>": "<token>" }.
## agentId is one of: receptionist, appointment, coordinator, refills.
## Create each in Dograh: POST /workflow/{id}/embed-token (widgetType=voice,
## embedMode=headless, allowed_domains=["clawleaf.com","*.clawleaf.com"]).
VITE_DOGRAH_EMBED_TOKENS={"receptionist":"","appointment":"","coordinator":"","refills":""}
## Single fallback embed token if a use case above is left blank.
VITE_DOGRAH_EMBED_TOKEN=

## Voice AI demo — SERVER-ONLY (Vercel env, used by /api/voice-ai-call; never exposed to the browser)
DOGRAH_VOICE_API_URL=https://voice-api.ot-technologies.com
DOGRAH_API_KEY=
## Phone-tab workflow per use case — JSON { "<agentId>": "<workflow uuid>" }.
DOGRAH_WORKFLOW_UUIDS={"receptionist":"","appointment":"","coordinator":"","refills":""}
## Single fallback workflow uuid if a use case above is left blank.
DOGRAH_WORKFLOW_UUID=

